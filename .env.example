# Supabase Dashboard > Connect > Transaction pooler (port 6543).
# URL-encode special characters in the database password. Never commit real values.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full
# Generate each secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Shared workspace password; username is labtrack. Required on Vercel/production.
LAB_APP_PASSWORD=
PORT=3000

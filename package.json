{
  "name": "labtrack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --watch src/local.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local src/local.js",
    "test": "node --test tests/postgres.test.js",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.js",
    "db:import": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13"
  }
}
